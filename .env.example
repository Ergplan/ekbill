# EkBill v2 — every environment variable the app, the worker and the scripts read.
# Copy to .env on the VM (paste 3 of docs/MASTER-PROMPT.md) and fill it there. Never commit .env.
# Production values come from Secret Manager through deploy/vm/up.sh.

# --- database ---------------------------------------------------------------
# Postgres 16 with pgvector. Local dev: scripts/local-postgres.sh (port 5440). VM: the db container (5441).
DATABASE_URL=postgres://postgres@127.0.0.1:5440/ekbill2_dev
# Tests use their own database and refuse any URL without "test" in the name.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5440/ekbill2_test

# --- sign-in ----------------------------------------------------------------
# switcher: /dev/switch lists seeded people (the build). otp: phone + SMS code (Twilio Verify).
AUTH_MODE=switcher
# Signs the session cookie. 32+ random characters.
SESSION_SECRET=

# --- models (the app's own; billed to the product) ---------------------------
OPENAI_API_KEY=
# Vision-capable model that reads photographed bills (Stage 7).
OPENAI_VISION_MODEL=
# Text model for Poocho answers (Stage 9).
OPENAI_TEXT_MODEL=
# Realtime model for voice (Stage 9), and its voice (default marin).
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
# Optional: a written copy of what the owner says to the voice (the realtime model hears the audio itself).
OPENAI_TRANSCRIBE_MODEL=
# Embedding model for Poocho's search by meaning (Stage 9; 256 dimensions are asked for). Empty: words only.
OPENAI_EMBED_MODEL=
# Optional prices, USD per million tokens, for ai_calls.cost_micros: OPENAI_VISION_PRICE_IN/OUT,
# OPENAI_TEXT_PRICE_IN/OUT, OPENAI_EMBED_PRICE_IN, OPENAI_REALTIME_PRICE_IN/OUT.

# --- the stage reviewer (rule 12; may be the same key as above) -------------
OPENAI_REVIEW_API_KEY=
# The exact model ID as the account's models list prints it. Stage 0 checks it resolves.
OPENAI_REVIEW_MODEL=

# --- documents --------------------------------------------------------------
# docling-serve for printed PDFs and scans. VM: http://docling:5001 inside the stack.
DOCLING_URL=http://127.0.0.1:5001
DOCLING_API_KEY=
# Chromium for PDF/JPEG rendering and Playwright. VM image: /usr/bin/chromium.
PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# --- deployment (read by deploy/vm/*.sh) --------------------------------------
# The HTTPS name Caddy serves. Empty: <ip-with-dashes>.sslip.io.
EKBILL_DOMAIN=
EKBILL_ACME_EMAIL=

# --- Twilio Verify (phone OTP; 19 Oct, in place of Firebase) ----------------------
# Used only with AUTH_MODE=otp. EkBill's server asks Twilio to SMS the code and to check it; the
# browser never sees these. From the Twilio console: Verify > Services > your service (VA...), and
# an API key (Account > API keys: SK... and its secret; preferred, it can be revoked on its own) or
# the account SID (AC...) and auth token. The secret/token is typed here with nano (never on a
# command line) or kept in Secret Manager as ekbill-twilio-api-key-secret / ekbill-twilio-auth-token,
# which up.sh reads when it is not set here. deploy/vm/check-env.sh tests them without sending an SMS.
# Rollback: AUTH_MODE=switcher here, then deploy/vm/up.sh.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: the custom template (HJ...) whose SMS ends "@<domain> #<code>", so Android Chrome fills the code in
# by itself. Twilio Support makes it: deploy/vm/twilio-template.sh writes the request. Not a secret.
TWILIO_VERIFY_TEMPLATE_SID=

# --- EkBill's own fee (20 Oct) ----------------------------------------------------
# The UPI address owners pay EkBill to: ₹20 a month after their first 20 bills (₹15 for a month a referred friend
# earned them). Empty: no fee is taken and nobody is stopped. Not a secret (every owner's plan screen shows it).
# deploy/vm/payments.sh lists the payments owners say they made, to confirm against the bank.
EKBILL_UPI_ID=
EKBILL_UPI_NAME=EkBill

# --- The app demo's voice (20 Oct) --------------------------------------------------
# Each demo line, in each language, is spoken once by this model and kept (up.sh records them after a deploy).
# Empty: gpt-4o-mini-tts, voice coral. Without an OpenAI key the demo shows its captions only.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# --- metrics (Stage 10/11) -----------------------------------------------------
# /api/metrics answers a request made on the VM itself (curl 127.0.0.1:8080/api/metrics) and, when this is set,
# a scraper sending "Authorization: Bearer <token>". Empty: the VM only.
METRICS_TOKEN=
