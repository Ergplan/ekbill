{
	email {$EKBILL_ACME_EMAIL}
}

# One site. HTTPS certificates are obtained and renewed automatically for EKBILL_DOMAIN
# (a real name like ekbill.aayuda.energy, or <ip-with-dashes>.sslip.io until there is one).
{$EKBILL_DOMAIN} {
	encode zstd gzip

	# The gate: deploy/caddy/gate-on.caddy puts a shared password in front of everything but
	# /api/health; gate-off.caddy puts nothing. deploy/vm/up.sh mounts one of them as gate.caddy
	# (EKBILL_GATE=on|off; off during the build, by the operator's decision of 15 Oct 2026).
	import /etc/caddy/gate.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000 {
		# A photo through OCR can take a minute or two.
		transport http {
			read_timeout 5m
		}
	}
}
